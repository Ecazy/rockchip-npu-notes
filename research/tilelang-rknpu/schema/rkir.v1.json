{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rockchip-npu-notes.local/schema/rkir.v1.json",
  "title": "RKIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "profile_hash", "source_hash", "state_signature", "inputs", "outputs", "values", "ops"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "rkir"},
    "name": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string"},
    "source_hash": {"type": "string"},
    "state_signature": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
    "ops": {"type": "array", "items": {"$ref": "#/$defs/op"}}
  },
  "$defs": {
    "tensor_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "axes", "index_map", "finite"],
      "properties": {
        "dtype": {"const": "float16"},
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 4096}},
        "axes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
        "stride": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "index_map": {"const": "identity"},
        "finite": {"type": "boolean"}
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "producer", "role"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/tensor_type"},
        "producer": {"type": ["integer", "null"], "minimum": 0},
        "role": {"enum": ["input", "constant", "temporary", "output", "state"]}
      }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "opcode", "inputs", "outputs", "attrs", "source", "side_effects"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "opcode": {"enum": ["matmul", "add", "mul", "silu", "gelu", "sigmoid", "hardsigmoid"]},
        "inputs": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "outputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 0}},
        "attrs": {"type": "object"},
        "source": {"type": "string"},
        "side_effects": {"const": false}
      }
    }
  }
}
