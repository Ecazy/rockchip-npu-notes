{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rockchip-npu-notes.local/schema/rkplan.v1.json",
  "title": "RKPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "profile_hash", "source_hash", "bindings", "constants", "buffers", "views", "actions", "submits", "publish", "accounting", "plan_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "rkplan"},
    "name": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string"},
    "source_hash": {"type": "string"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "role", "dtype", "shape"], "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string"}, "role": {"enum": ["input", "constant", "output"]}, "dtype": {"const": "float16"}, "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 4096}}}}},
    "constants": {"type": "array", "items": {"type": "object"}},
    "buffers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "role", "slot_id", "offset", "capacity", "alignment", "layout_id", "lifetime", "padding_state", "must_not_share_bo"], "properties": {"id": {"type": "integer", "minimum": 0}, "role": {"type": "string"}, "slot_id": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0}, "capacity": {"type": "integer", "minimum": 1}, "alignment": {"type": "integer", "minimum": 16}, "layout_id": {"enum": ["co.cube.f16.v1", "co.weight.f16.v1", "co.linear.f16.v1"]}, "lifetime": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}, "padding_state": {"enum": ["zero", "finite", "unknown", "valid_only"]}, "must_not_share_bo": {"type": "array", "items": {"type": "integer", "minimum": 0}}}}},
    "views": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "template_id", "inputs", "outputs", "deps", "origin", "attrs"], "properties": {"id": {"type": "integer", "minimum": 0}, "kind": {"enum": ["host_pack", "host_expand", "host_check", "upload", "npu_task", "download", "host_compute", "commit"]}, "template_id": {"type": ["string", "null"]}, "inputs": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "outputs": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "deps": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "origin": {"type": "string"}, "attrs": {"type": "object"}}}},
    "submits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "task_ids", "recipe_id", "mode", "core_policy", "deps"], "properties": {"id": {"type": "integer", "minimum": 0}, "task_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0}}, "recipe_id": {"type": "string"}, "mode": {"enum": ["chain", "separate"]}, "core_policy": {"enum": ["single_core_per_submit", "auto"]}, "deps": {"type": "array", "items": {"type": "integer", "minimum": 0}}}}},
    "publish": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "binding_id", "view_id"], "properties": {"name": {"type": "string"}, "binding_id": {"type": "integer", "minimum": 0}, "view_id": {"type": "integer", "minimum": 0}}}},
    "accounting": {"type": "object"}
  }
}
